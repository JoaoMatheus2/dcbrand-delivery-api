{
  "version": 2,
  "builds": [
    {
      "src": "api/delivery-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "admin-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/delivery-api.js"
    },
    {
      "src": "/(.*)",
      "dest": "/admin-web/dist/index.html"
    }
  ]
}