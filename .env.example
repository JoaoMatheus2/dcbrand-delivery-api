# ============================================================================
# DC Brand Delivery API - Environment Variables
# ============================================================================

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dcbrand
DB_PASSWORD=seu_password_aqui
DB_NAME=dcbrand_delivery

# Correios API
# Obter em: https://www.correios.com.br/business/atendimento
CORREIOS_USER=seu_usuario_correios
CORREIOS_PASSWORD=sua_senha_correios
CORREIOS_CONTRACT=seu_numero_contrato
CORREIOS_CEP_ORIGEM=50010020

# Logging
LOG_LEVEL=debug

# Cache (TTL em segundos)
CACHE_TTL_NEIGHBORHOODS=86400
CACHE_TTL_CORREIOS=3600

# CORS
CORS_ORIGIN=https://dcbrand-test.lovable.app,https://dcbrand.lovable.app

# JWT (para admin depois)
JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRY=24h

# WhatsApp API (opcional, para notificações)
WHATSAPP_PHONE=5581991074103
WHATSAPP_API_KEY=sua_chave_whatsapp
